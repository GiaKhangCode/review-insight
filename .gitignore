# ---------------------------------------------------------------
# Secrets: never commit. Only the template (.env.example) is tracked.
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Data: raw datasets are downloaded by scripts/download_data.py
# (UIT-ViSFD terms: research use, do not redistribute).
# ---------------------------------------------------------------
# Leading "/" anchors the rule to the repo root. Without it, `data/` would also hide
# src/review_insight/data/ (code) and evals/data/ (committed sample indices).
/data/

# Eval response cache (re-runs cost $0). Results JSON in evals/results/ IS tracked.
evals/.cache/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment created by `uv sync`
.venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
