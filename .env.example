# Copy to `.env` and fill in. `.env` is gitignored, never commit real values.
# Every variable is read and validated at startup by src/review_insight/config.py;
# the app refuses to start if a required one is missing.

# --- App ---------------------------------------------------------------
APP_ENV=local                     # local | ci | production
LOG_LEVEL=INFO
# Comma-separated keys accepted in the X-API-Key header.
API_KEYS=change-me-local-key
# Comma-separated origins allowed by CORS (the future Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- LLM (Google Gemini) -----------------------------------------------
GOOGLE_API_KEY=
PRIMARY_MODEL=gemini-3.1-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
LLM_TIMEOUT_S=15
FEWSHOT_STRATEGY=dynamic          # none | static | dynamic
FEWSHOT_K=5
BATCH_CONCURRENCY=5

# --- Prompts & observability (Langfuse Cloud) --------------------------
PROMPT_LABEL=production           # which Langfuse prompt label to serve
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database ----------------------------------------------------------
# Local docker compose Postgres. For Supabase, use the *session pooler*
# connection string (transaction pooler breaks asyncpg prepared statements).
DATABASE_URL=postgresql+asyncpg://review:review@localhost:5432/review_insight
